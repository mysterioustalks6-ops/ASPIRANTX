{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/protrack.apk",
      "destination": "/studyride.apk"
    },
    {
      "source": "/aspirantx.apk",
      "destination": "/studyride.apk"
    },
    {
      "source": "/ProTrack.apk",
      "destination": "/studyride.apk"
    },
    {
      "source": "/AspirantX.apk",
      "destination": "/studyride.apk"
    },
    {
      "source": "/StudyRide.apk",
      "destination": "/studyride.apk"
    },
    {
      "source": "/((?!api|landing-pages|assets|audio|auth-callback\\.html|favicon|logo|manifest\\.json|pwa-|apple-touch-icon|version\\.json|ads\\.txt|sitemap\\.xml|robots\\.txt|llms\\.txt|.*\\.apk|.*\\.(?:css|js|webp|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|mp3|wav|ogg)).*)",
      "destination": "/index.html"
    }
  ]
}
