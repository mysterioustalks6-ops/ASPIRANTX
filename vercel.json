{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "server.js"
    }
  },
  "crons": [
    {
      "path": "/api/cron/inactivity-emails",
      "schedule": "0 10 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"StudyRide.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/protrack.apk",
      "destination": "/studyride.apk"
    },
    {
      "source": "/aspirantx.apk",
      "destination": "/studyride.apk"
    },
    {
      "source": "/ProTrack.apk",
      "destination": "/studyride.apk"
    },
    {
      "source": "/AspirantX.apk",
      "destination": "/studyride.apk"
    },
    {
      "source": "/StudyRide.apk",
      "destination": "/studyride.apk"
    },
    {
      "source": "/((?!ads\\.txt|sitemap\\.xml|robots\\.txt|llms\\.txt|.*\\.apk).*)",
      "destination": "/index.html"
    }
  ]
}
