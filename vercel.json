{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(StudyRide.*|studyride|ProTrack.*|protrack|AspirantX.*|aspirantx)\\.apk",
      "destination": "/studyride.apk"
    },
    {
      "source": "/((?!ads\\.txt|sitemap\\.xml|robots\\.txt|.*\\.apk).*)",
      "destination": "/index.html"
    }
  ]
}
