# Production API Base URL (Used by Native Mobile APK & Remote Web Frontends)
# Example: VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=

# Gemini API Key (Server-side)
GEMINI_API_KEY=

# Google OAuth 2.0 Credentials (Direct Integration)
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Authoritative Database (Neon PostgreSQL)
DATABASE_URL=

# Authentication Secret
JWT_SECRET=

# Razorpay Integration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Service
RESEND_API_KEY=
