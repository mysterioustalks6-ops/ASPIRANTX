{
	"appId": "com.aspirantx.app",
	"appName": "AspirantX",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": false
	},
	"backgroundColor": "#020617",
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 1500,
			"launchAutoHide": true,
			"backgroundColor": "#020617",
			"showSpinner": false,
			"androidSplashResourceName": "splash"
		}
	}
}
