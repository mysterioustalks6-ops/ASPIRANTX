<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_block_overlay"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:descendantFocusability="beforeDescendants">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <!-- Outer Glassmorphic Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_glass_card"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <!-- ProTrack App Logo -->
            <ImageView
                android:id="@+id/ivProTrackLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/protrack_logo"
                android:contentDescription="ProTrack Logo"
                android:layout_marginBottom="12dp" />

            <!-- Pill Badge -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_shield"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="🛡️ FOCUS SHIELD ACTIVE"
                android:textColor="#818CF8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="14dp" />

            <!-- Blocked App Title -->
            <TextView
                android:id="@+id/tvBlockedAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Distraction App Locked"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="4dp" />

            <!-- Subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This application is locked to protect your focus."
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Live Countdown Timer Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_timer_card"
                android:paddingTop="18dp"
                android:paddingBottom="18dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOCKED FOR"
                    android:textColor="#818CF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvRemainingTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24:59"
                    android:textColor="#38BDF8"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:includeFontPadding="false"
                    android:layout_marginBottom="2dp" />

                <TextView
                    android:id="@+id/tvTimerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remaining until unlock"
                    android:textColor="#64748B"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Motivation Quote -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&quot;Discipline is choosing between what you want now, and what you want most.&quot;"
                android:textColor="#CBD5E1"
                android:textSize="12sp"
                android:textStyle="italic"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="22dp" />

            <!-- Primary Action: Return to ProTrack -->
            <Button
                android:id="@+id/btnReturnProTrack"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_btn_protrack"
                android:backgroundTint="@null"
                android:text="Return to ProTrack Study"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:layout_marginBottom="10dp" />

            <!-- Secondary Action: Go to Home Screen -->
            <Button
                android:id="@+id/btnGoHome"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_btn_home"
                android:backgroundTint="@null"
                android:text="Exit to Home Screen"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:textAllCaps="false" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
